# VinuSwap-Backend local environment (copy to .env; .env is gitignored).
# hardhat.config.ts reads exactly these variables. Never commit real values.

# Signer for `--network vinu` (chain 207). VINUSWAP_OWNER_PRIVATE_KEY wins;
# PRIVATE_KEY is the fallback. Leave both empty for read-only use.
VINUSWAP_OWNER_PRIVATE_KEY=
PRIVATE_KEY=

# JSON-RPC endpoint for `--network vinu`; defaults to https://rpc.vinuchain.org.
VINUSWAP_RPC_URL=

# Optional: number of hardhat-network signers (default 80).
HARDHAT_ACCOUNTS_COUNT=
